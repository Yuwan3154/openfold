#!/bin/bash
#SBATCH -J lf_engaging
#SBATCH -p mit_normal_gpu
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --exclude=node5101
#SBATCH --output=/home/chenxiou/logs/lf_engaging-%j.out
#SBATCH --error=/home/chenxiou/logs/lf_engaging-%j.err
# localfold AF2 on an Engaging L40S (user 10-09): clone the pinned opt-55 commit, apply the parity patch (LOCALFOLD_F32 / NO_MLM / RM_TEMPLATE_SEQ), build for the node's arch, run RUN_SCRIPT.
# usage: sbatch --export=ALL,LFROOT=/home/chenxiou/orcd/scratch/localfold_lf,RUN_SCRIPT=run_270.sh,OUT_DIR=out_fast_rm,N_EXPECT=270,PATCH=/home/chenxiou/orcd/scratch/localfold_lf/localfold_opt55_parity_switches.patch lf_engaging.sbatch
# LFROOT holds weights/model (fp32 bundle from lf_make_fp32_bundle.py), tpl/ and RUN_SCRIPT (generated by lf_t3_make.py with TPL_DIR=$LFROOT/tpl NSHARDS=1).
module load cuda/12.9.1
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
export LFROOT
rc=0
if [ ! -x $LFROOT/localfold/cuda/af2/localfold-af2 ]; then
  rm -rf $LFROOT/localfold
  git clone --quiet https://github.com/sokrypton/localfold.git $LFROOT/localfold || rc=1
  cd $LFROOT/localfold && git checkout --quiet 74bac9d && git apply $PATCH || rc=1
  [ $rc = 0 ] && { bash cuda/build.sh af2 || rc=1; }
fi
[ -x $LFROOT/localfold/cuda/af2/localfold-af2 ] || rc=1
[ $rc = 0 ] && { bash $LFROOT/$RUN_SCRIPT || rc=1; }
n=$(ls $LFROOT/$OUT_DIR/*.pdb 2>/dev/null | wc -l); echo "outputs=$n expected=$N_EXPECT"; [ "$n" = "$N_EXPECT" ] || rc=1
echo "rc_final=$rc"
exit $rc
